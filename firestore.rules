rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dictionary/{entryId} {
      allow read, write: if true;
    }

    match /config/{configDoc} {
      allow read, write: if true;
    }

    match /screenshots/{screenshotId} {
      allow read, write: if true;
    }

    match /solver_history/{historyId} {
      allow read, write: if true;
    }
  }
}
